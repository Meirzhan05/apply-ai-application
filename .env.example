# Local demo works without credentials. Set DEMO_MODE=false only after configuring production services.
DEMO_MODE=true
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
OPENAI_API_KEY=
BROWSERBASE_API_KEY=
BROWSERBASE_PROJECT_ID=
CHROMIUM_EXECUTABLE_PATH=
TRIGGER_SECRET_KEY=
TRIGGER_PROJECT_REF=
APP_ORIGIN=
INTERNAL_TASK_SECRET=
TYPESAFE_API_KEY=
RESEND_API_KEY=
EMAIL_FROM=
# Set this to limit all outbound email to an authorized test inbox.
EMAIL_TEST_RECIPIENT=
JOB_BOARDS=greenhouse:example,lever:example,ashby:example
MONTHLY_SPEND_LIMIT_USD=500
PROJECTED_BROWSER_RUN_USD=1
PROJECTED_DRAFT_USD=0.20
# Comma-separated invited emails; configure this for a private deployment.
BETA_ALLOWED_EMAILS=

# Optional local LaTeX overrides; npm run setup:latex installs the defaults.
# Production workers configure these through their runtime build extension.
# TECTONIC_BIN=/absolute/path/to/tectonic
# TECTONIC_CACHE_DIR=/absolute/path/to/warmed/cache
